pragma solidity ^0.8.24;

import {BelowThresholdVerifier} from "../src/BelowThresholdVerifier.sol";
import {CommitmentValidityVerifier} from "../src/CommitmentValidityVerifier.sol";
import {ProtocolTypes as T} from "../src/ProtocolTypes.sol";

/// @dev Creation eth_call only: verify with the exact generated bytecode, then
/// return a boolean as constructor output. Nothing is signed or persisted.
contract MonadReadOnlyProbe {
    constructor(bool badge, bytes memory encodedProof, bytes memory encodedInputs) {
        T.Proof memory proof = abi.decode(encodedProof, (T.Proof));
        bool valid;
        if (badge) {
            BelowThresholdVerifier verifier = new BelowThresholdVerifier();
            valid = verifier.verifyProof(proof.a, proof.b, proof.c, abi.decode(encodedInputs, (uint256[13])));
        } else {
            CommitmentValidityVerifier verifier = new CommitmentValidityVerifier();
            valid = verifier.verifyProof(proof.a, proof.b, proof.c, abi.decode(encodedInputs, (uint256[14])));
        }
        assembly { mstore(0, valid) return(0, 32) }
    }
}
